<header class="site-header">
  <a class="site-header__brand" href="/">Defffy</a>

  <button
    class="site-header__toggle"
    type="button"
    aria-controls="site-nav"
    aria-expanded="false"
    data-nav-toggle
  >
    <span class="site-header__toggle-label" data-nav-label-open>Menu</span>
    <span class="site-header__toggle-label" data-nav-label-close hidden>Close</span>
  </button>

  <nav class="site-nav" id="site-nav" aria-label="Primary" data-nav>
    <ul class="site-nav__list">
      {% set navLinks = [
        { href: "/work/first-earth", label: "First Earth" },
        { href: "/journal", label: "Journal" },
        { href: "/sketches", label: "Sketches" }
      ] %}
      {% for link in navLinks %}
        {% set isCurrent = page.url == link.href or page.url == link.href + "/" %}
        <li>
          <a
            class="site-nav__link{% if isCurrent %} is-current{% endif %}"
            href="{{ link.href }}"
            {% if isCurrent %}aria-current="page"{% endif %}
          >{{ link.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</header>
